# buildVariable: Build a variable font from a source file
rule buildVariable
  command = $
      /tmp/claude-1000/-home-tob-gitrepos-github-nossikon/c2aeece5-4179-49c6-91b5-d36cf14e4e61/scratchpad/venv/bin/python3 $
      -m gftools.jobrunner fontmake --output-path $out -o variable $
      $fontmake_type $in $args $stamp
  description = buildVariable

# fix: Run gftools-fix
rule fix
  command = $
      /tmp/claude-1000/-home-tob-gitrepos-github-nossikon/c2aeece5-4179-49c6-91b5-d36cf14e4e61/scratchpad/venv/bin/python3 $
      -m gftools.jobrunner gftools-fix-font -o $out $args $in $stamp
  description = fix

# compress: Compress to webfont
rule compress
  command = $
      /tmp/claude-1000/-home-tob-gitrepos-github-nossikon/c2aeece5-4179-49c6-91b5-d36cf14e4e61/scratchpad/venv/bin/python3 $
      -m gftools.jobrunner fonttools ttLib.woff2 compress -o $out $in $stamp
  description = compress

# buildStat: Build a STAT table from one or more source files
rule buildSTAT-operation
  command = gftools-gen-stat --out $tempdir $args -- $in && mv $finalfile $
      $out $stamp
rule buildSTAT-postprocess
  command = gftools-gen-stat --inplace $args -- $in $stamp

# instantiateUfo: Create instance UFOs from a Glyphs or designspace file
rule instantiateUfo
  command = $
      /tmp/claude-1000/-home-tob-gitrepos-github-nossikon/c2aeece5-4179-49c6-91b5-d36cf14e4e61/scratchpad/venv/bin/python3 $
      -m gftools.jobrunner fontmake -i "$instance_name" -o ufo $
      $fontmake_type $in $args $stamp
  description = instantiateUfo

# buildTTF: Build a TTF from a source file
rule buildTTF
  command = $
      /tmp/claude-1000/-home-tob-gitrepos-github-nossikon/c2aeece5-4179-49c6-91b5-d36cf14e4e61/scratchpad/venv/bin/python3 $
      -m gftools.jobrunner fontmake --output-path $out -o ttf $
      $fontmake_type $in $args $stamp
  description = buildTTF

# autohint: Run gftools-autohint
rule autohint
  command = $
      /tmp/claude-1000/-home-tob-gitrepos-github-nossikon/c2aeece5-4179-49c6-91b5-d36cf14e4e61/scratchpad/venv/bin/python3 $
      -m gftools.jobrunner gftools-autohint $args -o $out $in $stamp
  description = autohint

# copy: Copy a file
rule copy
  command = $
      /tmp/claude-1000/-home-tob-gitrepos-github-nossikon/c2aeece5-4179-49c6-91b5-d36cf14e4e61/scratchpad/venv/bin/python3 $
      -m gftools.jobrunner cp $in $out $stamp
  description = copy

# Generating /tmp/tmpu06b5pst
build /tmp/tmpu06b5pst: buildVariable ../build/ufo/NossikonSans.designspace
  operation = buildVariable
  args = --filter ...  --filter FlattenComponentsFilter --filter $
      DecomposeTransformedComponentsFilter
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
# Generating ../build/ufo/instance_ufos/NossikonSans-Thin.ufo.json
build ../build/ufo/instance_ufos/NossikonSans-Thin.ufo.json: instantiateUfo $
    ../build/ufo/NossikonSans.designspace
  operation = instantiateUfo
  instance_name = Nossikon Sans Thin
  fontmake_type = -m
  fontmake_args =  --verbose WARNING 
  args =  --ufo-structure=json --output-dir ../build/ufo/instance_ufos
